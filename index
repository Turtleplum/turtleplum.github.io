<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Portfolio — Creative Technologist</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=JetBrains+Mono:wght@300;400&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #161412;
      --bg2: #1E1B18;
      --ink: #F0EBE1;
      --muted: #7A7060;
      --accent: #E8401C;
      --accent2: #F2C94C;
      --line: #2E2A25;
      --display: 'Bebas Neue', sans-serif;
      --serif: 'Fraunces', Georgia, serif;
      --mono: 'JetBrains Mono', monospace;
      --px: clamp(1.2rem, 5vw, 3.5rem);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: var(--mono);
      font-weight: 300;
      overflow-x: hidden;
    }

    /* touch devices get normal cursor */
    @media (hover: hover) and (pointer: fine) {
      body { cursor: none; }
    }

    /* ── Grain overlay ── */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='1'/%3E%3C/svg%3E");
      opacity: 0.035;
      pointer-events: none;
      z-index: 9000;
    }

    /* ── Custom cursor (desktop only) ── */
    #cur, #cur-trail {
      display: none;
    }
    @media (hover: hover) and (pointer: fine) {
      #cur {
        display: block;
        position: fixed; width: 12px; height: 12px;
        background: var(--accent); border-radius: 50%;
        pointer-events: none; z-index: 9999;
        transform: translate(-50%,-50%);
        transition: width .15s, height .15s;
        mix-blend-mode: difference;
      }
      #cur.big { width: 48px; height: 48px; }
      #cur-trail {
        display: block;
        position: fixed; width: 32px; height: 32px;
        border: 1px solid var(--ink); border-radius: 50%;
        pointer-events: none; z-index: 9998;
        transform: translate(-50%,-50%);
        opacity: .3;
      }
    }

    /* ── Nav ── */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 500;
      display: flex; justify-content: space-between; align-items: center;
      padding: 1.4rem var(--px);
      background: rgba(22,20,18,0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid transparent;
      transition: border-color .3s;
    }
    nav.scrolled { border-bottom-color: var(--line); }

    .nav-logo {
      font-family: var(--display);
      font-size: 1.5rem;
      letter-spacing: .08em;
      color: var(--ink);
      text-decoration: none;
      z-index: 10;
    }

    /* Desktop links */
    .nav-links {
      display: flex; gap: 2rem; list-style: none;
    }
    .nav-links a {
      font-family: var(--mono);
      font-size: .68rem;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: var(--ink);
      text-decoration: none;
      opacity: .5;
      transition: opacity .2s;
      padding: .3rem 0;
    }
    .nav-links a:hover { opacity: 1; }

    /* Hamburger */
    .hamburger {
      display: none;
      flex-direction: column;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: .5rem;
      z-index: 10;
    }
    .hamburger span {
      display: block;
      width: 24px; height: 1.5px;
      background: var(--ink);
      transition: transform .3s, opacity .3s;
      transform-origin: center;
    }
    .hamburger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
    .hamburger.open span:nth-child(2) { opacity: 0; }
    .hamburger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

    /* Mobile drawer */
    .mobile-menu {
      display: none;
      position: fixed;
      inset: 0;
      background: var(--bg);
      z-index: 400;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      padding: 4rem var(--px);
      opacity: 0;
      pointer-events: none;
      transition: opacity .3s;
    }
    .mobile-menu.open {
      opacity: 1;
      pointer-events: all;
    }
    .mobile-menu ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 1.2rem;
    }
    .mobile-menu ul a {
      font-family: var(--display);
      font-size: clamp(2.5rem, 10vw, 4rem);
      letter-spacing: .06em;
      color: var(--ink);
      text-decoration: none;
      opacity: .25;
      transition: opacity .2s, color .2s;
      display: block;
    }
    .mobile-menu ul a:hover, .mobile-menu ul a:active { opacity: 1; color: var(--accent); }
    .mobile-menu-sub {
      margin-top: 3rem;
      font-size: .65rem;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: var(--muted);
    }

    /* ── Hero ── */
    #hero {
      min-height: 100svh;
      display: grid;
      grid-template-rows: 1fr auto;
      padding: 0 var(--px) 3.5rem;
      position: relative;
      overflow: hidden;
    }

    .hero-slash {
      position: absolute;
      top: -10%; right: -5%;
      width: 55%; height: 130%;
      background: var(--bg2);
      transform: skewX(-8deg);
      z-index: 0;
    }
    .hero-slash::after {
      content: '';
      position: absolute; inset: 0;
      background: repeating-linear-gradient(
        135deg, transparent, transparent 40px,
        rgba(232,64,28,.04) 40px, rgba(232,64,28,.04) 41px
      );
    }

    .hero-blob {
      position: absolute;
      top: 15%; right: 8%;
      width: clamp(160px, 35vw, 340px);
      height: clamp(160px, 35vw, 340px);
      background: radial-gradient(circle at 40% 40%, rgba(232,64,28,.22), transparent 70%);
      border-radius: 50%;
      filter: blur(40px);
      z-index: 0;
      animation: blobDrift 8s ease-in-out infinite alternate;
    }
    @keyframes blobDrift { from{transform:translate(0,0) scale(1);} to{transform:translate(20px,15px) scale(1.08);} }

    .hero-content {
      position: relative; z-index: 1;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding-top: clamp(7rem, 20vh, 12rem);
    }

    .hero-tag {
      font-size: clamp(.6rem, 2vw, .68rem);
      letter-spacing: .2em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 1.2rem;
      display: flex; align-items: center; gap: .8rem;
      opacity: 0; animation: slideIn .7s .3s forwards;
    }
    .hero-tag::before { content: ''; width: 20px; height: 1px; background: var(--accent); flex-shrink: 0; }

    .hero-name {
      font-family: var(--display);
      font-size: clamp(4.5rem, 15vw, 14rem);
      line-height: .88;
      letter-spacing: .02em;
      color: var(--ink);
      opacity: 0; animation: slideIn .8s .5s forwards;
    }
    .hero-name span { color: var(--accent); }

    .hero-sub {
      font-family: var(--serif);
      font-style: italic;
      font-size: clamp(1rem, 3vw, 2rem);
      color: var(--muted);
      margin-top: 1rem;
      opacity: 0; animation: slideIn .8s .7s forwards;
      line-height: 1.6;
    }

    .hero-bottom {
      position: relative; z-index: 1;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 1rem;
      border-top: 1px solid var(--line);
      padding-top: 1.5rem;
      margin-top: 2rem;
      opacity: 0; animation: fadeIn .9s 1s forwards;
    }

    .hero-roles { display: flex; gap: .7rem; flex-wrap: wrap; }
    .role-pill {
      font-size: .58rem;
      letter-spacing: .12em;
      text-transform: uppercase;
      border: 1px solid var(--line);
      padding: .4rem .8rem;
      color: var(--muted);
      transition: border-color .2s, color .2s;
      white-space: nowrap;
    }

    .hero-scroll {
      font-size: .6rem;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: var(--muted);
      display: flex; align-items: center; gap: .6rem;
      white-space: nowrap;
    }
    .scroll-dot {
      width: 6px; height: 6px;
      background: var(--accent); border-radius: 50%;
      animation: pulse 1.8s infinite; flex-shrink: 0;
    }
    @keyframes pulse { 0%,100%{opacity:1;transform:scale(1);} 50%{opacity:.3;transform:scale(.6);} }

    /* ── Section base ── */
    section { padding: clamp(4rem, 10vh, 8rem) var(--px); }

    .s-label {
      font-size: .6rem;
      letter-spacing: .22em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 1rem;
      display: flex; align-items: center; gap: .8rem;
    }
    .s-label::before { content: '//'; color: var(--accent2); opacity: .6; }

    .s-title {
      font-family: var(--display);
      font-size: clamp(2.6rem, 8vw, 7rem);
      line-height: .92;
      letter-spacing: .03em;
    }
    .s-title em {
      font-family: var(--serif);
      font-style: italic;
      font-size: .75em;
      color: var(--muted);
      letter-spacing: 0;
    }

    /* ── About ── */
    #about { background: var(--bg); position: relative; overflow: hidden; }
    #about::before {
      content: 'ABOUT';
      position: absolute;
      font-family: var(--display);
      font-size: 22vw;
      color: var(--bg2);
      bottom: -2vw; left: -1vw;
      line-height: 1;
      pointer-events: none;
      user-select: none;
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 5rem;
      margin-top: 4rem;
      position: relative; z-index: 1;
    }

    .about-bio p {
      font-family: var(--serif);
      font-size: clamp(1rem, 2.5vw, 1.15rem);
      line-height: 1.9;
      color: #ADA89E;
      margin-bottom: 1.4rem;
    }
    .about-bio p strong { color: var(--ink); font-weight: 600; }
    .about-bio p em { color: var(--accent2); font-style: italic; }

    .tag-cloud { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 2.5rem; }
    .tag {
      font-size: .6rem;
      letter-spacing: .12em;
      text-transform: uppercase;
      padding: .4rem .9rem;
      border: 1px solid var(--line);
      color: var(--muted);
      transition: all .2s;
      /* touch-friendly tap target */
      min-height: 36px;
      display: flex; align-items: center;
    }
    @media (hover: hover) { .tag:hover { background: var(--accent); border-color: var(--accent); color: #fff; } }

    .toolkit { border-left: 2px solid var(--line); padding-left: 2rem; }
    .toolkit-title {
      font-size: .6rem;
      letter-spacing: .2em;
      text-transform: uppercase;
      color: var(--accent2);
      margin-bottom: 2rem;
    }
    .tool-row {
      display: flex; justify-content: space-between; align-items: center;
      padding: .9rem 0;
      border-bottom: 1px solid var(--line);
      font-size: .78rem;
      color: var(--muted);
      min-height: 44px;
    }
    .tool-row:first-of-type { border-top: 1px solid var(--line); }
    .tool-dot { width: 6px; height: 6px; background: var(--line); border-radius: 50%; transition: background .2s; flex-shrink: 0; }
    @media (hover: hover) {
      .tool-row:hover .tool-dot { background: var(--accent); }
      .tool-row:hover { color: var(--ink); }
    }

    /* ── Work ── */
    #work { background: var(--bg2); }

    .work-filter {
      display: flex; gap: .6rem; flex-wrap: wrap;
      margin: 2.5rem 0 3rem;
    }
    .filter-btn {
      font-family: var(--mono);
      font-size: .62rem;
      letter-spacing: .12em;
      text-transform: uppercase;
      padding: .55rem 1rem;
      background: transparent;
      border: 1px solid var(--line);
      color: var(--muted);
      cursor: pointer;
      transition: all .2s;
      min-height: 40px;
    }
    .filter-btn:hover, .filter-btn.active {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
    }

    .work-masonry {
      columns: 3;
      column-gap: 1.2rem;
    }
    .work-item {
      break-inside: avoid;
      margin-bottom: 1.2rem;
      position: relative;
      overflow: hidden;
      cursor: pointer;
      transition: opacity .3s, transform .3s;
    }
    .thumb-inner { position: relative; overflow: hidden; }

    .wt { width: 100%; display: block; }
    .wt-1 { aspect-ratio: 4/3;  background: linear-gradient(135deg, #2A2218, #3D1F10); }
    .wt-2 { aspect-ratio: 1/1;  background: linear-gradient(135deg, #1A2230, #0D3040); }
    .wt-3 { aspect-ratio: 3/4;  background: linear-gradient(135deg, #1E1A2E, #2D1540); }
    .wt-4 { aspect-ratio: 16/9; background: linear-gradient(135deg, #1C2218, #1A3020); }
    .wt-5 { aspect-ratio: 1/1;  background: linear-gradient(135deg, #251818, #3D1010); }
    .wt-6 { aspect-ratio: 4/5;  background: linear-gradient(135deg, #1A1C20, #202830); }

    .thumb-tag {
      position: absolute; bottom: .8rem; left: .8rem;
      font-size: .55rem; letter-spacing: .14em; text-transform: uppercase;
      background: var(--bg); color: var(--muted);
      padding: .25rem .6rem;
    }

    .work-cap {
      padding: .8rem 0 .4rem;
      display: flex; justify-content: space-between; align-items: baseline;
      gap: .5rem;
    }
    .work-cap-name {
      font-family: var(--serif);
      font-size: clamp(.85rem, 2vw, 1rem);
      font-weight: 500;
    }
    .work-cap-year { font-size: .6rem; color: var(--muted); letter-spacing: .1em; white-space: nowrap; }

    .work-hover-line {
      position: absolute; bottom: 0; left: 0;
      width: 0; height: 2px;
      background: var(--accent);
      transition: width .4s cubic-bezier(.4,0,.2,1);
    }
    @media (hover: hover) {
      .work-item:hover .work-hover-line { width: 100%; }
      .work-item:hover .wt { transform: scale(1.04); }
    }
    .wt { transition: transform .6s cubic-bezier(.4,0,.2,1); }

    /* ── Marquee ── */
    .marquee-wrap {
      background: var(--accent);
      padding: 1rem 0;
      overflow: hidden;
      white-space: nowrap;
    }
    .marquee-track {
      display: inline-flex;
      animation: marquee 18s linear infinite;
    }
    .marquee-item {
      font-family: var(--display);
      font-size: clamp(1rem, 3vw, 1.4rem);
      letter-spacing: .06em;
      color: #fff;
      padding: 0 1.5rem;
      display: inline-flex; align-items: center; gap: 1.5rem;
    }
    .marquee-item::after { content: '✦'; opacity: .5; font-size: .8em; }
    @keyframes marquee { from{transform:translateX(0);} to{transform:translateX(-50%);} }

    /* ── Process ── */
    #process { background: var(--bg); }
    .process-list { margin-top: 4rem; }
    .process-row {
      display: grid;
      grid-template-columns: 64px 1fr 1fr;
      gap: 1.5rem;
      align-items: start;
      padding: 2.5rem 0;
      border-bottom: 1px solid var(--line);
    }
    .process-row:first-child { border-top: 1px solid var(--line); }
    .process-num {
      font-family: var(--display);
      font-size: 3rem;
      color: var(--line);
      line-height: 1;
      transition: color .3s;
    }
    @media (hover: hover) { .process-row:hover .process-num { color: var(--accent); } }
    .process-name {
      font-family: var(--serif);
      font-size: clamp(1.3rem, 3vw, 1.8rem);
      font-weight: 500;
      line-height: 1.1;
      padding-top: .3rem;
    }
    .process-desc {
      font-size: .8rem;
      line-height: 1.8;
      color: var(--muted);
      padding-top: .5rem;
    }

    /* ── Terminal ── */
    #terminal-block {
      background: #0D0C0A;
      padding: clamp(2.5rem, 6vh, 5rem) var(--px);
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }
    .terminal {
      max-width: 680px;
      border: 1px solid var(--line);
      background: #111009;
      overflow: hidden;
    }
    .terminal-bar {
      background: var(--line);
      padding: .6rem 1rem;
      display: flex; align-items: center; gap: .5rem;
    }
    .t-dot { width: 10px; height: 10px; border-radius: 50%; }
    .t-dot-r { background: #E8401C; }
    .t-dot-y { background: #F2C94C; }
    .t-dot-g { background: #27AE60; }
    .terminal-body { padding: 1.4rem; overflow-x: auto; }
    .t-line { font-family: var(--mono); font-size: clamp(.68rem, 2vw, .8rem); line-height: 2; white-space: nowrap; }
    .t-prompt { color: var(--accent2); }
    .t-cmd { color: var(--ink); }
    .t-out { color: var(--muted); }
    .t-hi { color: var(--accent); }
    .t-cursor {
      display: inline-block; width: 7px; height: 1em;
      background: var(--ink); vertical-align: middle;
      animation: blink .8s step-end infinite;
    }
    @keyframes blink { 0%,100%{opacity:1;} 50%{opacity:0;} }

    /* ── Contact ── */
    #contact { background: var(--bg2); position: relative; overflow: hidden; }
    #contact::after {
      content: 'LET\'S\A TALK';
      position: absolute;
      font-family: var(--display);
      font-size: 18vw;
      color: transparent;
      -webkit-text-stroke: 1px var(--line);
      bottom: -2vw; right: -2vw;
      line-height: .85;
      pointer-events: none;
      user-select: none;
      white-space: pre;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
      margin-top: 4rem;
      position: relative; z-index: 1;
    }

    .contact-form { display: flex; flex-direction: column; gap: 1.8rem; }
    .cf-field { display: flex; flex-direction: column; gap: .5rem; }
    .cf-field label {
      font-size: .6rem; letter-spacing: .18em; text-transform: uppercase;
      color: var(--accent2);
    }
    .cf-field input, .cf-field textarea, .cf-field select {
      background: transparent;
      border: none;
      border-bottom: 1px solid var(--line);
      padding: .8rem 0;
      font-family: var(--mono);
      font-size: .85rem;
      font-weight: 300;
      color: var(--ink);
      outline: none;
      transition: border-color .3s;
      resize: none;
      -webkit-appearance: none;
      width: 100%;
      /* prevent iOS zoom on focus */
      font-size: max(.85rem, 16px);
    }
    .cf-field select option { background: var(--bg2); }
    .cf-field input:focus, .cf-field textarea:focus, .cf-field select:focus { border-color: var(--accent); }
    .cf-field textarea { min-height: 90px; }

    .btn-submit {
      align-self: flex-start;
      background: var(--accent);
      color: #fff;
      border: none;
      padding: 1rem 2.2rem;
      font-family: var(--mono);
      font-size: .72rem;
      letter-spacing: .18em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background .25s, transform .15s;
      clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 0 100%);
      min-height: 48px;
    }
    @media (hover: hover) { .btn-submit:hover { background: var(--accent2); color: var(--bg); transform: translateY(-2px); } }

    .contact-right { padding-top: .5rem; }
    .c-item { margin-bottom: 2.5rem; }
    .c-item-label { font-size: .6rem; letter-spacing: .2em; text-transform: uppercase; color: var(--accent); margin-bottom: .5rem; }
    .c-item-val {
      font-family: var(--serif);
      font-size: clamp(1.1rem, 3vw, 1.3rem);
      font-weight: 400;
      color: var(--ink);
      text-decoration: none;
      display: block;
      transition: color .2s;
    }
    @media (hover: hover) { .c-item-val:hover { color: var(--accent); } }

    .avail-badge {
      display: inline-flex; align-items: center; gap: .6rem;
      font-size: .62rem; letter-spacing: .14em; text-transform: uppercase;
      border: 1px solid #27AE60;
      color: #27AE60;
      padding: .5rem 1rem;
      margin-top: 2rem;
    }
    .avail-dot { width: 6px; height: 6px; background: #27AE60; border-radius: 50%; animation: pulse 2s infinite; flex-shrink: 0; }

    /* ── Footer ── */
    footer {
      background: var(--bg);
      border-top: 1px solid var(--line);
      padding: 2rem var(--px);
      display: flex; justify-content: space-between; align-items: center;
      flex-wrap: wrap; gap: .8rem;
      font-size: .62rem;
      letter-spacing: .1em;
      color: var(--muted);
    }
    footer span b { color: var(--accent); font-weight: 400; }
    footer a { color: var(--muted); text-decoration: none; }

    /* ── Animations ── */
    @keyframes slideIn { from{opacity:0;transform:translateY(28px);} to{opacity:1;transform:translateY(0);} }
    @keyframes fadeIn  { from{opacity:0;} to{opacity:1;} }

    .reveal {
      opacity: 0; transform: translateY(28px);
      transition: opacity .8s cubic-bezier(.4,0,.2,1), transform .8s cubic-bezier(.4,0,.2,1);
    }
    .reveal.on { opacity: 1; transform: translateY(0); }
