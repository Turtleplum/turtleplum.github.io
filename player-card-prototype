<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Player Card Hero — Prototype</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Caveat:wght@600;700&family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=JetBrains+Mono:wght@300;400&display=swap" rel="stylesheet">

  <style>
    /* ── Same tokens as the current site ── */
    :root, [data-theme="dark"] {
      --bg: #161412;
      --bg2: #1E1B18;
      --ink: #F0EBE1;
      --muted: #7A7060;
      --accent: #E8401C;
      --accent2: #F2C94C;
      --line: #2E2A25;
      --nav-bg: rgba(22,20,18,0.85);
      --hero-slash-line: rgba(232,64,28,.05);
      --card-glow: rgba(232,64,28,.20);
      --tape: rgba(242,201,76,.22);
      --ok: #27AE60;
      --display: 'Bebas Neue', sans-serif;
      --serif: 'Fraunces', Georgia, serif;
      --hand: 'Caveat', cursive;
      --mono: 'JetBrains Mono', monospace;
      --px: clamp(1rem, 5vw, 3.5rem);
      --gap: clamp(.9rem, 1.6vw, 1.25rem);
    }
    [data-theme="light"] {
      --bg: #F5F2ED;
      --bg2: #EAE6DF;
      --ink: #1A1714;
      --muted: #6E6656;
      --accent: #D4370F;
      --accent2: #B4780A;
      --line: #D4CEC5;
      --nav-bg: rgba(245,242,237,0.88);
      --hero-slash-line: rgba(232,64,28,.07);
      --card-glow: rgba(232,64,28,.12);
      --tape: rgba(201,134,10,.28);
      --ok: #1E8A4C;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--bg); color: var(--ink);
      font-family: var(--mono); font-weight: 300;
      overflow-x: hidden; transition: background .4s, color .4s;
    }
    body::before {
      content: ''; position: fixed; inset: 0; pointer-events: none; z-index: 9000; opacity: .03;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    }
    a:focus-visible, button:focus-visible { outline: 2px solid var(--accent2); outline-offset: 3px; }

    /* ── Nav (trimmed copy of current) ── */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 500;
      display: flex; justify-content: space-between; align-items: center;
      padding: 1.2rem var(--px); background: var(--nav-bg);
      backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    }
    .nav-logo { font-family: var(--display); font-size: 1.3rem; letter-spacing: .06em; color: var(--ink); text-decoration: none; }
    .nav-links { display: flex; gap: 2rem; list-style: none; }
    .nav-links a { font-size: .68rem; letter-spacing: .18em; text-transform: uppercase; color: var(--ink); text-decoration: none; opacity: .5; transition: opacity .2s; }
    .nav-links a:hover, .nav-links a.on { opacity: 1; }
    .nav-links a.on { color: var(--accent); }
    .nav-right { display: flex; align-items: center; gap: 1.6rem; }
    .theme-toggle {
      background: none; border: 1px solid var(--line); color: var(--muted); cursor: pointer;
      width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; font-size: .9rem;
    }
    .theme-toggle:hover { border-color: var(--accent); }

    /* ── Hero / player card grid ── */
    #hero { min-height: 100svh; padding: clamp(6.5rem, 15vh, 8.5rem) var(--px) 3rem; }
    .pc-grid {
      max-width: 1400px; margin: 0 auto;
      display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gap);
    }
    .pc {
      background: var(--bg2); border: 1px solid var(--line); position: relative;
      opacity: 0; animation: slideIn .8s cubic-bezier(.4,0,.2,1) var(--d, 0s) forwards;
      transition: background .4s, border-color .3s;
    }
    .pc-label {
      font-size: .6rem; letter-spacing: .22em; text-transform: uppercase; color: var(--accent);
      display: flex; align-items: center; gap: .6rem;
    }
    .pc-label::before { content: '//'; color: var(--accent2); opacity: .6; }

    /* Profile card */
    .pc-card {
      grid-column: 1 / span 8; grid-row: 1 / span 2;
      min-height: clamp(440px, 64vh, 600px);
      display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr);
    }
    .pc-card-bg { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
    .pc-card-bg::before {
      content: ''; position: absolute; inset: 0;
      background: repeating-linear-gradient(135deg, transparent 0 40px, var(--hero-slash-line) 40px 41px);
    }
    .pc-card-bg::after {
      content: ''; position: absolute; right: 2%; top: 10%;
      width: 60%; aspect-ratio: 1; border-radius: 50%;
      background: radial-gradient(circle at 45% 45%, var(--card-glow), transparent 68%);
      filter: blur(30px); animation: blobDrift 8s ease-in-out infinite alternate;
    }
    /* tape strips — keeps the handmade feel */
    .tape { position: absolute; width: 92px; height: 24px; background: var(--tape); z-index: 4; pointer-events: none; }
    .tape.tl { top: -11px; left: 28px; transform: rotate(-4deg); }
    .tape.br { bottom: -10px; right: 36px; transform: rotate(3deg); }

    .pc-card-body {
      position: relative; z-index: 3; padding: clamp(1.4rem, 3vw, 2.4rem);
      display: flex; flex-direction: column;
    }
    .pc-top { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
    .pc-pill { font-size: .62rem; letter-spacing: .18em; text-transform: uppercase; background: var(--ink); color: var(--bg); padding: .38rem .85rem; font-weight: 400; }
    .pc-stars { color: var(--accent2); letter-spacing: .25em; font-size: .78rem; }
    .pc-name {
      font-family: var(--display); font-weight: 400;
      font-size: clamp(4rem, 7.4vw, 7.6rem); line-height: .86; letter-spacing: .02em;
      margin-top: auto; padding-top: 2.5rem;
    }
    .pc-name span { color: var(--accent); display: block; }
    .pc-title { font-size: clamp(.6rem, 1.4vw, .7rem); letter-spacing: .2em; text-transform: uppercase; color: var(--muted); margin-top: 1rem; line-height: 1.8; }
    .pc-path { margin-top: 1.8rem; max-width: 260px; }
    .pc-path-label { font-size: .58rem; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); padding-bottom: .5rem; border-bottom: 1px solid var(--line); margin-bottom: .7rem; }
    .pc-path-val { display: flex; align-items: center; gap: .75rem; font-family: var(--serif); font-style: italic; font-size: 1.2rem; }
    .pc-path-icon { width: 36px; height: 36px; flex-shrink: 0; border: 1px solid var(--accent); border-radius: 50%; display: grid; place-items: center; color: var(--accent); font-style: normal; font-size: .9rem; }
    .pc-sign { margin-top: 1.6rem; font-family: var(--hand); font-size: 1.35rem; color: var(--muted); transform: rotate(-1.5deg); transform-origin: left; }

    /* Portrait slot — art breaks out of the top of the card, like the reference */
    .pc-portrait { position: relative; z-index: 2; min-height: 300px; }
    .pc-portrait-frame {
      position: absolute; inset: -2.2rem 1.6rem 1.6rem 0;
      border: 1px dashed var(--muted); background: var(--bg);
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .6rem;
      overflow: hidden;
    }
    .pc-portrait-frame::before {
      content: ''; position: absolute; inset: 0;
      background: repeating-linear-gradient(45deg, transparent 0 14px, var(--hero-slash-line) 14px 15px);
    }
    .ph-mono { position: relative; font-family: var(--display); font-size: clamp(9rem, 16vw, 15rem); line-height: .8; color: transparent; -webkit-text-stroke: 1.5px var(--accent); opacity: .55; }
    .ph-note { position: relative; font-family: var(--hand); font-size: 1.2rem; color: var(--muted); text-align: center; max-width: 18ch; line-height: 1.15; transform: rotate(-2deg); }
    .pc-portrait-img { position: absolute; bottom: 0; right: 0; height: 112%; width: 100%; object-fit: contain; object-position: bottom center; }
    .pc-portrait.has-art .pc-portrait-frame { display: none; }

    /* Class tiles */
    .pc-classes { grid-column: 9 / span 4; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); }
    .pc-class {
      text-decoration: none; color: var(--ink);
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .55rem;
      padding: 1rem .4rem; min-height: 132px; text-align: center;
      transition: transform .3s cubic-bezier(.34,1.56,.64,1), border-color .3s, background .4s;
    }
    .pc-class svg { width: 38px; height: 38px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; color: var(--accent); transition: transform .3s; }
    .pc-class.worlds svg { color: var(--accent2); }
    .pc-class-name { font-family: var(--display); font-size: 1.25rem; letter-spacing: .06em; line-height: 1; }
    .pc-class-sub { font-size: .52rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); line-height: 1.5; }
    @media (hover: hover) {
      .pc-class:hover { transform: translateY(-4px) rotate(-1deg); border-color: var(--accent); }
      .pc-class.worlds:hover { border-color: var(--accent2); }
      .pc-class:hover svg { transform: scale(1.08); }
    }

    /* Loadout */
    .pc-loadout { grid-column: 9 / span 4; padding: 1.25rem; display: flex; flex-direction: column; }
    .pc-head { display: flex; justify-content: space-between; align-items: baseline; gap: .8rem; margin-bottom: 1rem; }
    .pc-aside { font-family: var(--hand); font-size: 1.1rem; color: var(--muted); white-space: nowrap; }
    .pc-slots { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .55rem; margin-top: auto; }
    .slot {
      aspect-ratio: 1; border: 1px solid var(--line); background: var(--bg);
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .2rem;
      padding: .3rem; text-align: center; transition: border-color .2s, color .2s, transform .2s;
    }
    .slot b { font-family: var(--display); font-weight: 400; font-size: clamp(1.1rem, 1.8vw, 1.4rem); letter-spacing: .04em; line-height: 1; }
    .slot small { font-size: .46rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); line-height: 1.25; }
    @media (hover: hover) {
      .slot:hover { transform: translateY(-2px); }
      .slot.sys:hover { border-color: var(--accent); color: var(--accent); }
      .slot.art:hover { border-color: var(--accent2); color: var(--accent2); }
    }

    /* Stats — real numbers only */
    .pc-stats { grid-column: 1 / span 8; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .stat { padding: 1.2rem 1.3rem 1.3rem; border-right: 1px solid var(--line); }
    .stat:last-child { border-right: none; }
    .stat-num { font-family: var(--display); font-size: clamp(2.6rem, 4.6vw, 4rem); line-height: 1; letter-spacing: .02em; }
    .stat-num i { font-style: normal; color: var(--accent); }
    .stat-label { font-size: .58rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin-top: .5rem; line-height: 1.6; }

    /* Status + CTAs */
    .pc-status { grid-column: 9 / span 4; padding: 1.25rem; display: flex; flex-direction: column; justify-content: space-between; gap: 1.1rem; }
    .avail { display: flex; align-items: center; gap: .6rem; font-size: .62rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ok); }
    .avail-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); flex-shrink: 0; animation: pulse 2s infinite; }
    .pc-loc { font-family: var(--serif); font-size: 1.1rem; margin-top: .5rem; }
    .pc-ctas { display: flex; gap: .6rem; flex-wrap: wrap; }
    .btn {
      font-family: var(--mono); font-size: .66rem; letter-spacing: .16em; text-transform: uppercase;
      text-decoration: none; padding: .85rem 1.3rem; min-height: 44px; display: inline-flex; align-items: center;
      transition: background .25s, color .25s, border-color .25s, transform .15s;
    }
    .btn-main { background: var(--accent); color: #fff; clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 0 100%); }
    .btn-ghost { border: 1px solid var(--line); color: var(--ink); }
    @media (hover: hover) {
      .btn-main:hover { background: var(--accent2); color: var(--bg); transform: translateY(-2px); }
      .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }
    }

    /* ── Marquee (unchanged, shows how the hero sits in the page) ── */
    .marquee-wrap { background: var(--accent); padding: 1rem 0; overflow: hidden; white-space: nowrap; }
    .marquee-track { display: inline-flex; animation: marquee 22s linear infinite; }
    .marquee-item { font-family: var(--display); font-size: clamp(1rem, 3vw, 1.4rem); letter-spacing: .06em; color: #fff; padding: 0 1.5rem; display: inline-flex; align-items: center; gap: 1.5rem; }
    .marquee-item::after { content: '✦'; opacity: .5; font-size: .8em; }
    .next-hint { padding: 4rem var(--px); text-align: center; font-family: var(--hand); font-size: 1.4rem; color: var(--muted); }

    @keyframes slideIn { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
    @keyframes blobDrift { from { transform: translate(0,0) scale(1); } to { transform: translate(-18px,14px) scale(1.08); } }
    @keyframes pulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: .3; transform: scale(.6); } }
    @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

    /* ── Tablet ── */
    @media (max-width: 1024px) {
      .pc-card    { grid-column: 1 / -1; grid-row: auto; }
      .pc-classes { grid-column: 1 / span 6; }
      .pc-loadout { grid-column: 7 / span 6; }
      .pc-stats   { grid-column: 1 / -1; }
      .pc-status  { grid-column: 1 / -1; flex-direction: row; align-items: center; flex-wrap: wrap; }
      .pc-classes .pc-class { min-height: 100%; }
    }
    @media (max-width: 860px) {
      .nav-links { display: none; }
    }
    /* ── Phone ── */
    @media (max-width: 640px) {
      .pc-classes, .pc-loadout { grid-column: 1 / -1; }
      .pc-card { grid-template-columns: 1fr; min-height: 0; margin-top: 1.4rem; }
      .pc-portrait { order: -1; min-height: 300px; }
      .pc-portrait-frame { inset: -1.4rem 1rem 0 1rem; }
      .pc-card-body { padding-top: 1.6rem; }
      .pc-name { padding-top: 1.2rem; }
      .pc-classes .pc-class { min-height: 118px; }
      .pc-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .stat:nth-child(2) { border-right: none; }
      .stat:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
      .pc-status { flex-direction: column; align-items: stretch; }
      .pc-ctas .btn { flex: 1; justify-content: center; }
      .tape.br, .pc-card > .tape.tl { display: none; }
      .arr-r { display: none; }
      .pc-sign .arr-u { display: inline; }
    }
    .arr-u { display: none; }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
    }
  </style>
</head>
