        <div class="slot sys"><b>Fig</b><small>Figma</small></div>
        <div class="slot art"><b>Bl</b><small>Blender</small></div>
        <div class="slot art"><b>CSP</b><small>Clip Studio</small></div>
        <div class="slot art"><b>AE</b><small>After FX</small></div>
        <div class="slot sys"><b>WS</b><small>Wireshark</small></div>
      </div>
    </div>

    <!-- STATS -->
    <div class="pc pc-stats" style="--d:.62s">
      <div class="stat"><div class="stat-num"><span data-to="7">0</span><i>+</i></div><div class="stat-label">Years<br>illustrating</div></div>
      <div class="stat"><div class="stat-num"><span data-to="5">0</span></div><div class="stat-label">Projects shipped<br>at Datakraf</div></div>
