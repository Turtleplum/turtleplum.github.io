        <span class="pc-class-name">Flags</span>
        <span class="pc-class-sub">CTF<br>&amp; Security</span>
      </a>
    </div>

    <!-- LOADOUT -->
    <div class="pc pc-loadout" style="--d:.54s">
      <div class="pc-head">
        <span class="pc-label">Loadout</span>
        <span class="pc-aside">what I actually reach for</span>
      </div>
      <div class="pc-slots">
        <div class="slot sys"><b>Py</b><small>Python</small></div>
        <div class="slot sys"><b>C++</b><small>C / C++</small></div>
