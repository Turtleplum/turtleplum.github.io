    <!-- STATUS -->
    <div class="pc pc-status" style="--d:.7s">
      <div>
        <div class="avail"><span class="avail-dot"></span>Open to work &amp; collabs — 2026</div>
        <div class="pc-loc">Based in Kuala Lumpur</div>
      </div>
      <div class="pc-ctas">
        <a class="btn btn-main" href="#work">See the work →</a>
        <a class="btn btn-ghost" href="mailto:farizhassan99@gmail.com">Say hi</a>
      </div>
    </div>

  </div>
</section>

